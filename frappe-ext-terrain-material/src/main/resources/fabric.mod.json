{
	"schemaVersion": 1,
	"id": "${mod_id}-ext-terrain-material",
	"version": "${mod_version}",
	"name": "Frappé Extension - Terrain Material",
	"description": "An extension providing programmable Terrain Materials.",
	"authors": [
		"Sylv <contact@sylv.gay>"
	],
	"license": "${mod_license}",
	"icon": "assets/frappe-ext-terrain-material/icon.png",
	"environment": "client",
	"custom": {
		"frappe": {
			"schemaVersion": 0,
			"supportTier": "experimental",
			"implType": "gay.sylv.frappe.api.ext.terrain_material.TerrainMaterialExtension",
			"config": {
				"frappe-ext-render-pipeline": {
					"enabled": true
				},
				"frappe-ext-material": {
					"enabled": true
				}
			}
		},
		"frappe-ext-render-pipeline:shader-format": {
			"shaderFormats": [
				"shader-formats/frp-terrain-material"
			]
		}
	}
}
