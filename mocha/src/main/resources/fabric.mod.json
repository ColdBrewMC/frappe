{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "Mocha",
	"description": "An implementation of Frappé for Indigo and Sodium.",
	"authors": [
		"Sylv <contact@sylv.gay>"
	],
	"contact": {
		"homepage": "https://sylv.gay/",
		"sources": "https://github.com/sylv256/frappe"
	},
	"license": "${mod_license}",
	"icon": "assets/mocha/icon.png",
	"environment": "client",
	"entrypoints": {
		"frappe-base:renderer_info": ["gay.sylv.frappe.mocha.impl.base.MochaRendererInfo"],
		"frappe:frappe-ext-material": ["gay.sylv.frappe.mocha.impl.indigo.material.IndiumMaterialExtension"],
		"frappe:frappe-ext-terrain-material": ["gay.sylv.frappe.mocha.impl.indigo.terrain_material.IndigoTerrainMaterialExtension"],
		"frappe:frappe-ext-quad-view": ["gay.sylv.frappe.mocha.impl.indigo.quad_view.IndigoQuadViewExtension"],
		"frappe:frappe-ext-render-pipeline": ["gay.sylv.frappe.mocha.impl.indium.render_pipeline.IndiumRenderPipelineExtension"],
		"client": ["gay.sylv.frappe.mocha.impl.indigo.terrain_material.IndigoTerrainMaterialInitializer"]
	},
	"mixins": [
		{
			"environment": "client",
			"config": "mocha.mixins.json"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.0"
	},
	"breaks": {
		"sodium": "<${sodium_version}"
	}
}
